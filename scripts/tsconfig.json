{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../build/backtest",
    "noEmit": false,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": [
    "../src/backtest/**/*.ts",
    "./*.ts"
  ]
}
